        "import pandas as pd\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "\n",
        "# Dados dos produtos conforme fornecido no exercício\n",
        "dados = {\n",
        "    'peso': [10, 15, 8, 20, 25, 7],\n",
        "    'preco': [100, 150, 80, 200, 250, 70],\n",
        "    'premium': [1, 1, 0, 1, 1, 0],\n",
        "    'importado': [0, 1, 0, 1, 1, 0],\n",
        "    'fragil': [1, 0, 1, 0, 1, 1],\n",
        "    'eletronico': [1, 1, 0, 1, 1, 0]\n",
        "}\n",
        "\n",
        "# Cria um DataFrame do pandas com os dados dos produtos\n",
        "produtos = pd.DataFrame(dados)\n",
        "\n",
        "# Define o número de vizinhos para o algoritmo k-NN\n",
        "k = 3\n",
        "\n",
        "# Define as colunas que serão usadas como rótulos (variáveis a serem previstas)\n",
        "labels = [\n",
        "    'premium',\n",
        "    'importado',\n",
        "    'fragil',\n",
        "    'eletronico'\n",
        "]\n",
        "\n",
        "# Quantidade de rótulos (características) a serem processados\n",
        "q = len(labels)\n",
        "\n",
        "# Número total de amostras (produtos) na base de dados\n",
        "N = produtos.shape[0]\n",
        "\n",
        "# Loop para processar cada rótulo individualmente (abordagem one-vs-rest para classificação multirrótulo)\n",
        "for j in range(0, q):\n",
        "\n",
        "    print('--------------------------------------')\n",
        "    # Imprime qual rótulo está sendo processado atualmente\n",
        "    print('PROCESSANDO O RÓTULO', labels[j])\n",
        "\n",
        "    # Inicializa a Matriz de Confusão para armazenar os resultados da classificação\n",
        "    # 'predito_nao' e 'predito_sim' são as previsões do modelo\n",
        "    # 'real_nao' e 'real_sim' são os valores verdadeiros do rótulo\n",
        "    mc = pd.DataFrame({\n",
        "        'predito_nao': [0, 0],\n",
        "        'predito_sim': [0, 0]\n",
        "    }, index=['real_nao', 'real_sim'])\n",
        "\n",
        "    # X são as features (características de entrada), excluindo as colunas de rótulos\n",
        "    X = produtos.drop(columns=labels)\n",
        "\n",
        "    # Y é o rótulo atual que estamos tentando prever\n",
        "    Y = produtos[labels[j]]\n",
        "\n",
        "    # Loop de Leave-One-Out (LOO) para avaliação do modelo:\n",
        "    # A cada iteração, uma amostra é usada como teste e as restantes como treino.\n",
        "    for i in range(0, N):\n",
        "\n",
        "        # Divide os dados em conjuntos de treino e teste\n",
        "        # X_treino contém todas as features, exceto a amostra 'i'\n",
        "        X_treino = X.drop([i])\n",
        "\n",
        "        # Y_treino contém todos os rótulos, exceto o da amostra 'i'\n",
        "        Y_treino = Y.drop([i])\n",
        "\n",
        "        # X_teste contém apenas a feature da amostra 'i'\n",
        "        X_teste = X.iloc[[i], :]\n",
        "\n",
        "        # Y_teste contém o rótulo verdadeiro da amostra 'i'\n",
        "        Y_teste = Y.iloc[i]\n",
        "\n",
        "        # Inicializa o modelo k-NN com o número de vizinhos 'k'\n",
        "        modelo = KNeighborsClassifier(n_neighbors=k)\n",
        "\n",
        "        # Treina o modelo com os dados de treino\n",
        "        modelo.fit(X_treino, Y_treino)\n",
        "\n",
        "        # Faz a predição para a amostra de teste\n",
        "        pred = modelo.predict(X_teste)\n",
        "\n",
        "        # Atualiza a Matriz de Confusão com base na predição e no valor real\n",
        "        if (Y_teste == 0): # Se o valor real é 'não' (0)\n",
        "\n",
        "            if (pred == 0): # Se o modelo previu 'não' (0) corretamente\n",
        "                mc.iloc[0, 0] += 1 # Incrementa verdadeiro negativo\n",
        "\n",
        "            if (pred == 1): # Se o modelo previu 'sim' (1) incorretamente\n",
        "                mc.iloc[0, 1] += 1 # Incrementa falso positivo\n",
        "\n",
        "        else: # Se o valor real é 'sim' (1)\n",
        "\n",
        "            if (pred == 0): # Se o modelo previu 'não' (0) incorretamente\n",
        "                mc.iloc[1, 0] += 1 # Incrementa falso negativo\n",
        "\n",
        "            if (pred == 1): # Se o modelo previu 'sim' (1) corretamente\n",
        "                mc.iloc[1, 1] += 1 # Incrementa verdadeiro positivo\n",
        "\n",
        "    # Após o loop LOO, imprime a Matriz de Confusão para o rótulo atual\n",
        "    print(mc)\n",
        "\n",
        "    # Calcula a acurácia do modelo para o rótulo atual\n",
        "    # Acurácia = (Verdadeiro Positivo + Verdadeiro Negativo) / Total de Amostras\n",
        "    acuracia = (mc.iloc[0, 0] + mc.iloc[1, 1]) / N\n",
        "\n",
        "    # Imprime a acurácia arredondada para duas casas decimais\n",
        "    print('acurácia =', round(acuracia, 2))"
